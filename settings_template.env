# ============================================================
#  Sketchbook Buddy settings
#  1. Rename this file to:  settings.env
#  2. Paste your bot token after DISCORD_TOKEN=
#  3. Never share this file or post it anywhere. The token is a password.
# ============================================================

# REQUIRED: from the Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# The bot's name in its messages (optional)
BOT_NAME=Sketchbook Buddy

# Folder where plans, streaks and logs are saved. Leave blank to use this folder.
# On Railway, add a Volume mounted at /data and set this to /data so nothing is lost when you update.
DATA_DIR=

# ---------- Optional: daily sketchbook warm-up ----------
# Right-click a channel > Copy Channel ID (needs Developer Mode on). Leave blank to switch off.
DAILY_CHANNEL_ID=
# Hour for the daily warm-up AND the morning plan reminders (24-hour clock), and the time zone
DAILY_HOUR=9
TIMEZONE=Europe/London

# ---------- Optional: AI chat mode (costs a little per message) ----------
# Leave blank and the bot runs free, on its own rules. Add a key from console.anthropic.com to switch AI chat on.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 = cheapest. claude-sonnet-5-5 = smarter, about 10x the cost.
AI_MODEL=claude-haiku-5-5
# Max AI messages per day, to keep costs under control
AI_DAILY_LIMIT=60
# Only these Discord user IDs can use AI chat (comma separated). Blank = anyone who can message the bot.
AI_ALLOWED_USER_IDS=
